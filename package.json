{
  "name": "sereno",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal dashboard for a Linux home server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ingenious-agency/sereno.git"
  },
  "files": [
    "bin/",
    "dist/",
    "config.example.json",
    "README.md"
  ],
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26.4.0"
  },
  "bin": {
    "sereno": "bin/sereno"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "start": "node --experimental-ffi src/main.ts",
    "fixtures": "node --experimental-ffi src/main.ts --fixtures",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-ffi --test test/*.test.ts",
    "smoke": "node src/main.ts --snapshot"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  }
}
